  "api": {
    "getHealth": {
      "method": "GET",
      "path": "/v1/health"
    },
    "getMarketplaces": {
      "method": "GET",
      "path": "/v1/marketplaces"
    },
    "getProviders": {
      "method": "GET",
      "path": "/v1/providers"
    },
    "getAccountConnectors": {
      "method": "GET",
      "path": "/v1/account-connectors"
    },
    "getAccounts": {
      "method": "GET",
      "path": "/v1/accounts"
    },
    "createAccount": {
      "method": "POST",
      "path": "/v1/accounts"
    },
    "updateAccount": {
      "method": "PUT",
      "path": "/v1/accounts/:id"
    },
    "removeAccount": {
      "method": "DELETE",
      "path": "/v1/accounts/:id"
    },
    "getLists": {
      "method": "GET",
      "path": "/v1/lists"
    },
    "createList": {
      "method": "POST",
      "path": "/v1/lists"
    },
    "getList": {
      "method": "GET",
      "path": "/v1/lists/:id"
    },
    "addListItem": {
      "method": "POST",
      "path": "/v1/lists/:id/items"
    },
    "updateListItem": {
      "method": "PUT",
      "path": "/v1/lists/:id/items/:itemId"
    },
    "removeListItem": {
      "method": "DELETE",
      "path": "/v1/lists/:id/items/:itemId"
    },
    "getProducts": {
      "method": "GET",
      "path": "/v1/products"
    },
    "searchProducts": {
      "method": "POST",
      "path": "/v1/products/search"
    },
    "refreshProduct": {
      "method": "POST",
      "path": "/v1/products/:id/refresh"
    },
    "observeProduct": {
      "method": "POST",
      "path": "/v1/products/:id/observation"
    },
    "reloadProviders": {
      "method": "POST",
      "path": "/v1/providers/reload"
    },
    "testAmazonCreators": {
      "method": "POST",
      "path": "/v1/providers/amazon-creators/test"
    },
    "getShipments": {
      "method": "GET",
      "path": "/v1/shipments"
    },
    "addShipment": {
      "method": "POST",
      "path": "/v1/shipments"
    },
    "updateShipment": {
      "method": "PUT",
      "path": "/v1/shipments/:id"
    }
